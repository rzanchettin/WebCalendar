@page
@using WebCalendar.Entities
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-fluid px-1 mt-4">
    <h1>Calendário</h1>

    <form method="post" class="row g-3 align-items-center" id="mainForm">
        <div class="col-auto">
            <label for="yearInput" class="col-form-label">Ano</label>
        </div>
        <div class="col-auto">
            <input id="yearInput" name="Year" type="number" class="form-control" min="1" max="9999" placeholder="2026" value="@Model.Year" />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#birthdaysModal">Aniversários</button>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#holidaysModal">Feriados</button>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#notesModal">Anotações</button>
        </div>
    </form>

    @if (!Model.ModelState.IsValid)
    {
        <div class="text-danger mt-2">@Html.ValidationSummary()</div>
    }

    @if (Model.Months != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="row">
                    @for (int i = 0; i < Model.Months.Count; i++)
                    {
                        var m = Model.Months[i];
                        <div class="col-12 col-md-4 mb-4">
                            <div class="card">
                                <div class="card-body p-2">
                                    <table class="table table-sm table-bordered mb-0 text-center">
                                        <thead>
                                            <tr>
                                                <th class="month-name" colspan="7">@m.Name @m.Year</th>
                                            </tr>
                                            <tr>
                                                <th class="weekday-header">Dom</th>
                                                <th class="weekday-header">Seg</th>
                                                <th class="weekday-header">Ter</th>
                                                <th class="weekday-header">Qua</th>
                                                <th class="weekday-header">Qui</th>
                                                <th class="weekday-header">Sex</th>
                                                <th class="weekday-header">Sáb</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var week in m.Weeks)
                                            {
                                                <tr>
                                                    @for (int dIndex = 0; dIndex < week.Count; dIndex++)
                                                    {
                                                        var dayVal = week[dIndex];
                                                        if (dayVal.HasValue)
                                                        {
                                                            var cellDate = new DateTime(m.Year, m.Month, dayVal.Value);
                                                            var isToday = cellDate.Date == DateTime.Now.Date;
                                                            var isWeekend = (dIndex == 0 || dIndex == 6);

                                                            // Check holiday, birthday and note
                                                            var holiday = m.Holidays?.FirstOrDefault(h => h.Day == dayVal.Value);
                                                            var birthday = m.Birthdays?.FirstOrDefault(b => b.Day == dayVal.Value);
                                                            var note = m.Notes?.FirstOrDefault(n => n.Day == dayVal.Value && (n.Recurring || n.Year == m.Year));

                                                            var titleParts = new List<string>();
                                                            if (holiday != null && (holiday.Recurring || holiday.Year == m.Year)) titleParts.Add(holiday.Name);
                                                            if (birthday != null) titleParts.Add(birthday.Name);
                                                            if (note != null) titleParts.Add(note.Name);
                                                            var title = titleParts.Count > 0 ? string.Join(" | ", titleParts) : "";

                                                            // Determine background and text styles. Holiday overrides weekend/weekday backgrounds.
                                                            var bgStyle = "";
                                                            var textStyle = "";

                                                            if (holiday != null && (holiday.Recurring || holiday.Year == m.Year))
                                                            {
                                                                // Holiday background: light green if today, otherwise light blue
                                                                if (isToday)
                                                                {
                                                                    bgStyle = "background-color:#d4edda;"; // light green
                                                                }
                                                                else
                                                                {
                                                                    bgStyle = "background-color:#cfe2ff;"; // light blue
                                                                }

                                                                // Holiday text: red bold, override other color rules
                                                                textStyle = "color:#c00 !important;font-weight:700;";
                                                            }
                                                            else if (isToday)
                                                            {
                                                                bgStyle = "background-color:#000;color:#fff;";
                                                            }
                                                            else if (isWeekend)
                                                            {
                                                                bgStyle = "background-color:#ffe6f2;";
                                                            }
                                                            else
                                                            {
                                                                bgStyle = "background-color:#fff9c4;";
                                                            }

                                                            // If today, add a thicker blue border
                                                            var borderStyle = "";
                                                            if (isToday)
                                                            {
                                                                // Use an outline instead of border so it is always visible (including left side)
                                                                // and make it a bit thicker
                                                                borderStyle = "outline:3px solid #0d6efd;outline-offset:-1px;";
                                                            }

                                                            // Compose final style
                                                            var finalStyle = bgStyle + textStyle + borderStyle;

                                                            <td style="@(finalStyle)" title="@(title)" class="clickable-day" data-day="@dayVal" data-month="@m.Month" data-year="@m.Year">
                                                                @if (birthday != null)
                                                                {
                                                                    <span class="birthday-circle">@dayVal</span>
                                                                }
                                                                else if (note != null)
                                                                {
                                                                    <span class="note-circle">@dayVal</span>
                                                                }
                                                                else
                                                                {
                                                                    @dayVal
                                                                }
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<partial name="Modals/_AddEventModal"/>

<script>
    const birthdays = @Html.Raw(Json.Serialize(Model.AllBirthdays));
    const holidays = @Html.Raw(Json.Serialize(Model.AllHolidays));
    const notes = @Html.Raw(Json.Serialize(Model.AllNotes));
</script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await Html.PartialAsync("Modals/_ListEventModal", new ListEventModalViewModel
{
    ModalId = "birthdaysModal",
    Title = "Aniversariantes",
    EmptyMessage = "Nenhum aniversariante encontrado.",
    Year = Model.DisplayYear,
    Items = Model.BirthdaysVm
})

@await Html.PartialAsync("Modals/_ListEventModal", new ListEventModalViewModel
{
    ModalId = "holidaysModal",
    Title = "Feriados",
    EmptyMessage = "Nenhum feriado encontrado.",
    Year = Model.DisplayYear,
    Items = Model.HolidaysVm
})

@await Html.PartialAsync("Modals/_ListEventModal", new ListEventModalViewModel
{
    ModalId = "notesModal",
    Title = "Anotações",
    EmptyMessage = "Nenhuma anotação encontrada.",
    Year = Model.DisplayYear,
    Items = Model.NotesVm
}) 

